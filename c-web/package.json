{
  "name": "fleetops-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:desktop": "vite --mode desktop --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build",
    "build:desktop": "vue-tsc --noEmit && vite build --mode desktop",
    "test": "vitest run"
  },
  "dependencies": {
    "@mygo-plugins/fetch": "0.10.0",
    "mygo-runtime": "0.10.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "playwright": "^1.56.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.9.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0",
    "vue-tsc": "^3.0.0"
  }
}
